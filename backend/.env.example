# Для локального запуска бэкенда без Docker (uvicorn app.main:app --reload)
DATABASE_URL=postgresql+asyncpg://itprof_user:change-me-db-password@localhost:5432/itprof_db
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EXPOSE_DEBUG_CODES=true
CORS_ORIGINS=*
PUBLIC_BASE_URL=http://localhost:8000
