# Скопируйте в .env и замените значения: cp .env.example .env
POSTGRES_USER=itprof_user
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=itprof_db
POSTGRES_PORT=5432

# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# true — коды 2FA и восстановления пароля возвращаются в ответе API (имитация email, только для разработки)
EXPOSE_DEBUG_CODES=true
# Список origin через запятую или *
CORS_ORIGINS=*
PUBLIC_BASE_URL=http://localhost:8000
# Заполнить БД тестовыми данными при первом запуске (если БД пустая)
SEED_ON_START=true
# Лимит запросов к /auth/login, /auth/register и т.п. с одного IP в минуту
AUTH_RATE_LIMIT_PER_MINUTE=20

BACKEND_PORT=8000
HTTPS_PORT=8443
SWAGGER_PORT=8080
